# ═══════════════════════════════════════════════════════════
# stock-pipeline 환경 변수 설정
#   cp .env.example .env 후 값을 채워넣으세요.
#   chmod 600 .env   (권한 제한 권장)
# ═══════════════════════════════════════════════════════════

# ── 1단계: KRX 로그인 (pykrx 1.2.x 필수) ─────────────────
# pykrx 1.2 이상은 data.krx.co.kr 로그인을 요구합니다.
# https://www.krx.co.kr 에서 무료 회원가입 후 아래에 아이디/비밀번호를 넣으세요.
KRX_ID=
KRX_PW=

# ── 2단계: LLM 대본 생성 ────────────────────────────────
# 사용.provider: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 추론 모델(o*, gpt-5*, gpt-6*)은 temperature/response_format 미지원이며
# max_tokens 대신 max_completion_tokens 을 사용한다 (코드가 자동 처리).
OPENAI_MODEL=gpt-6-astra

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 2단계 대안: 로컬 LLM (Ollama) ───────────────────────
# LLM_PROVIDER=ollama 로 바꾸면 API 키 없이 로컬에서 대본을 만든다.
#   ollama pull qwen3:8b
# qwen3:8b(5.2GB) 는 빠르고 수치를 정확히 옮긴다.
# gpt-oss:20b 는 대본 생성에 수백 초가 걸리고 지시를 자주 어기므로 권하지 않는다.
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_THINK=false
OLLAMA_NUM_CTX=16384

# ── 3단계: TTS ──────────────────────────────────────────
# 사용.provider: openai | elevenlabs | gemini | gcloud
# 장편(7분) 제작은 OpenAI TTS 권장 — Gemini TTS 는 하루 한도가 작다.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_TIMEOUT=300

OPENAI_TTS_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

GEMINI_TTS_API_KEY=
GEMINI_TTS_VOICE=Kore

# ── 3단계: 단어 타임스탬프 (Whisper) ─────────────────────
# 기본 mlx-whisper (Apple Silicon Metal 가속)
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# MLX 실패 시 whisper-timestamped가 사용할 모델
WHISPER_FALLBACK_MODEL=medium

# ── 5단계: YouTube Data API v3 ─────────────────────────
# OAuth2 클라이언트 (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# 게시할 채널 ID (YouTube Studio → 채널 → 고급 설정)
YOUTUBE_CHANNEL_ID=
# 로컬 서버 인증 방식은 항상 http://localhost 를 사용하므로 이 값은 무시됩니다.
# --playground 수동 인증 방식에서만 사용됩니다.
YOUTUBE_REDIRECT_URI=https://developers.google.com/oauthplayground
# 최초 인증 토큰 저장 위치 (token_auth.py 실행 시 자동 생성)
YOUTUBE_TOKEN_PATH=./state/youtube_token.json

# ── 대본 검증: 바른 맞춤법 검사기 ───────────────────────
# https://bareun.ai/api-key 에서 발급받은 키를 넣으면 대본 검증에 자동 연결됩니다.
# 미설정 시 이 검사만 건너뛰고 나머지 검증은 그대로 동작합니다.

# ── 파이프라인 설정 ─────────────────────────────────────
# 오늘 처리할 영상 수
DAILY_VIDEO_COUNT=1
VIDEO_DURATION=long
LONG_TARGET_CHARS=2400
LONG_SECTION_GAP=0
# 영상 해상도: 4k | 1080p
VIDEO_RESOLUTION=4k
# YouTube 공개 상태: private | unlisted | public
YOUTUBE_VISIBILITY=private
# 예약 게시 여부
YOUTUBE_SCHEDULE_ENABLED=true

# ── 재무/리스크 제어 ───────────────────────────────────
# 한 번에 동시 처리할 LLM 요청 수
LLM_MAX_CONCURRENCY=3
# 한 번에 동시 처리할 TTS 요청 수
TTS_MAX_CONCURRENCY=3
# 타임아웃(초)
API_TIMEOUT=120
# ── LLM 품질 관리 ─────────────────────────────────────
# 대본 품질 검수 미달 시 재생성 시도 횟수
LLM_MAX_RETRIES=2

# ── TTS 음성 (낮은 베이스 · 신뢰감) ────────────────────
GOOGLE_TTS_VOICE=ko-KR-Neural2-C
GOOGLE_TTS_PROJECT=
GOOGLE_TTS_RATE=0.97
GOOGLE_TTS_PITCH=0.0

# ── 영상 말풍선 (마지막 카드) ────────────────────────
# 제공자 연락처는 contact.txt 에 적는다 (개인 파일 · git·소스번들 제외).
# 예시 파일: contact.example.txt 를 복사해 contact.txt 로 저장한다.
# 아래 항목은 contact.txt 를 쓰지 않을 때 쓰는 환경변수 대체값이다.
CONTACT_CHANNEL=채널 메시지로 문의
CONTACT_URL=
CONTACT_NOTE=종목 문의 · 자료 요청 가능

# 실제 제공할 자료명과 운영 중인 CONTACT_URL을 함께 설정하면 신청 CTA 활성화
LEAD_OFFER=
LEAD_CAMPAIGN=stock-analysis
